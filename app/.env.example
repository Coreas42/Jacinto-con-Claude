# Copia este archivo como .env y ajusta los valores.
# Base de datos. SQLite por defecto; para PostgreSQL usa, por ejemplo:
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/inventario
DATABASE_URL=sqlite:///inventario.db

# Nombre de la empresa que aparece en la ventana y los comprobantes.
NOMBRE_EMPRESA=Mi Empresa

# Muestra las consultas SQL en consola (true/false). Solo para depurar.
SQL_DEBUG=false
