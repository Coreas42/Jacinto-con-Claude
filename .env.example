# Copia este archivo como .env y ajusta los valores.
# Base de datos. SQLite por defecto; para PostgreSQL usa, por ejemplo:
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/inventario
DATABASE_URL=sqlite:///inventario.db

# Nombre de la empresa que aparece en la ventana y los comprobantes.
NOMBRE_EMPRESA=Mi Empresa

# Línea opcional bajo el nombre (ej. ACCESORIOS • INSTALACIÓN • POLARIZADO). Para el logo, guarda el archivo en assets/logo.png.
ESLOGAN_EMPRESA=

# Muestra las consultas SQL en consola (true/false). Solo para depurar.
SQL_DEBUG=false

# Primer administrador (lo usa seed.py). Si no defines la contraseña,
# seed.py la pide por consola o genera una aleatoria.
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@ejemplo.com
# ADMIN_CONTRASENA=
